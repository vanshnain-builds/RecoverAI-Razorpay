# RecoverAI frontend npm config.
#
# ignore-scripts=false ensures package lifecycle scripts run during install.
# esbuild (a transitive dependency of Vite) has a postinstall step that sets up
# its platform binary; if a global/corporate npm config sets ignore-scripts=true,
# this project-level override re-enables it so `npm run dev` works.
ignore-scripts=false

# Quieter, more deterministic installs.
fund=false
audit=false
