# RecoverAI — backend environment configuration
# Copy to backend/.env locally, or add the same variables in Render.
# NEVER commit backend/.env or real secrets to GitHub.

# === Razorpay (TEST MODE recommended for the hackathon) ===
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_FETCH_COUNT=100
RAZORPAY_FETCH_DAYS=90
RECOVERAI_NOTIFY=0
RECOVERAI_SIMULATE_COMPLETION=1

# === Supabase — server-side persistence ===
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# === OpenRouter + NVIDIA Nemotron 3.5 Lightning — AI reasoning ===
# Get the OpenRouter key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
RECOVERAI_LLM_MODEL=nvidia/nemotron-3.5-lightning:free
RECOVERAI_USE_LLM=1

# Optional OpenRouter attribution headers
# OPENROUTER_SITE_URL=https://your-frontend.onrender.com
# OPENROUTER_APP_NAME=RecoverAI
