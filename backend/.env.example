# RecoverAI — backend environment configuration
# Copy to backend/.env locally, or add the same variables in Render.
# NEVER commit backend/.env or real secrets to GitHub.

# === Razorpay (TEST MODE recommended for the hackathon) ===
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_FETCH_COUNT=100
RAZORPAY_FETCH_DAYS=90
RECOVERAI_NOTIFY=0
RECOVERAI_SIMULATE_COMPLETION=1

# === Supabase — server-side persistence ===
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# === NVIDIA Nemotron 3.5 Lightning — AI reasoning ===
# Get the key from NVIDIA Build: https://build.nvidia.com/nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
RECOVERAI_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
RECOVERAI_USE_LLM=1
