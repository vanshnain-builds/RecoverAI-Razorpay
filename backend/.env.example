# RecoverAI — backend configuration (EXAMPLE)
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the SAME folder (backend/.env) and fill in values.
# `.env` is gitignored, so your real keys never get committed.
#
#     cp .env.example .env      # macOS/Linux
#     copy .env.example .env    # Windows (cmd)
#
# EVERYTHING here is OPTIONAL. With no .env at all, RecoverAI runs exactly as the
# base demo: synthetic data + in-memory state + simulated reasoning. Each block
# below switches ON one real integration only when its keys are present.
# ---------------------------------------------------------------------------

# === Razorpay (TEST MODE) — ingest real payments + create real payment links ===
# Dashboard → Settings → API Keys → "Generate Test Key" (keys start with rzp_test_).
# Keep it on TEST keys for the demo. Leave blank to use the synthetic dataset.
RAZORPAY_KEY_ID=rzp_test_TYQpZ6MBhJXGjk
RAZORPAY_KEY_SECRET=WVTP109sE743Bp8uSk0Imobe
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME_WITH_WEBHOOK_SECRET

# How many payments to pull, and how far back (Razorpay caps a page at 100).
RAZORPAY_FETCH_COUNT=100
RAZORPAY_FETCH_DAYS=90

# Whether real payment links actually NOTIFY the customer by SMS/email.
# 0 = never message anyone (safe default for a demo). Set 1 only intentionally.
RECOVERAI_NOTIFY=0

# A payment link's COMPLETION (the customer actually paying) can only be
# confirmed by a webhook. For a self-contained demo we simulate completion using
# the executor's odds (1). Set 0 to instead mark real links as PENDING and never
# count them as recovered until a webhook confirms.
RECOVERAI_SIMULATE_COMPLETION=1

# === Supabase — write-through persistence via the PostgREST REST API ==========
# Run db/supabase_schema.sql once in the Supabase SQL editor first.
# URL: Project Settings → API → Project URL (https://<ref>.supabase.co)
# KEY: Project Settings → API → service_role secret (bypasses RLS; server-side only).
# Leave blank to stay in-memory.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# === Optional LLM reasoning (OFF by default) ==================================
# The default "reasoning" is a transparent heuristic — no LLM, fully offline.
# To route diagnosis/decision explanations through an LLM instead, set the flag
# AND provide one key. (Left off for this build.)
RECOVERAI_USE_LLM=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
